#!/bin/sh
set -eu

sleep "${FAKE_MYSQLDUMP_SLEEP_SECONDS:-0}"
if [ "${FAKE_MYSQLDUMP_IGNORE_TERM:-false}" = "true" ]; then
  trap '' TERM
fi

bytes="${FAKE_MYSQLDUMP_OUTPUT_BYTES:-0}"
printf '%s\n' '-- MySQL dump generated by failure evidence test' 'CREATE TABLE `evidence` (`id` bigint);'
if [ "$bytes" -gt 0 ]; then
  head -c "$bytes" /dev/zero | tr '\000' 'x'
fi
exit "${FAKE_MYSQLDUMP_EXIT_CODE:-0}"
